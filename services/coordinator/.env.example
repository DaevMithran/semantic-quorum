HOST=127.0.0.1
PORT=8787
# Public base URL evaluators use to fetch pages from this server
PUBLIC_URL=http://localhost:8787
# Optional: seed the board with cre/ test fixtures (keeps the offline scenarios working)
BOARD_SEED_FILE=../../cre/fixtures/board.json
BOARD_DATA_FILE=./board-data.json

# Evaluator pool: ENS id -> service URL (JSON)
EVALUATORS={"laya-2.judges.semanticquorum.eth":"http://localhost:8801","vela-1.judges.semanticquorum.eth":"http://localhost:8802"}

# Chainlink CRE (runs `cre workflow simulate` per round)
CRE_BIN=cre
CRE_DIR=../../cre
CRE_TARGET=local-settings
# true: pass --broadcast (needs config.write=true in the cre target config)
CRE_BROADCAST=false

# Relay fallback: submit CRE's signed verdict to SQController.submitVerdict
RELAY_ENABLED=false
ARC_RPC_URL=https://rpc.testnet.arc.io
SQ_CONTROLLER_ADDRESS=0x1f772f6a7764c227FCb9467E0E60D133C3CdA168
# Any funded Arc testnet key (pays gas only; the verdict is signed by the verdict authority)
RELAY_PRIVATE_KEY=

# ---- Marketplace (UI) ----
# Agent catalog (sellers + judge committee); addresses only, no keys
AGENTS_FILE=./agents.json
# Rubric drafting on 0G Private Computer (same 0G key as the evaluators is fine for the demo)
OG_API_KEY=
# Optional separate Router key for standard models. When set, it takes precedence over OG_API_KEY.
OG_STANDARD_API_KEY=
RUBRIC_MODEL=qwen3.7-flash
# Optional rubric fallback. Free models still require an OpenRouter account key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_MODEL=openai/gpt-4.1-nano
# Deals from the UI: demo buyer + seller wallets created by `make arc-job` (git-ignored)
ARC_KEYS_FILE=../../.env.arc
SELLER_DIR=../seller
# Optional JSON override. Defaults: page-agent=../seller, contract-agent=../contract-agent, 0g-agent=../0g-agent, failure-agent=../failure-agent
SELLER_DIRS={}
