# ---- identity (one process per pool member: laya-1..3, vela-1..3) ----
EVALUATOR_ID=laya-1.judges.semanticquorum.eth
EVALUATOR_PROFILE=0g-laya-teeml-v1
# EIP-712 report signer; its address must equal the committee member's reportKey
EVALUATOR_REPORT_KEY=

# ---- decisions provider (swap jev -> 0g by changing only these) ----
# jev:   https://api.typesafe.ai           path /v1/systemone   model jev-1.14.0
# 0g:    https://router-api.0g.ai          path /v1/decisions (confirm with the spike)
# local: http://127.0.0.1:8000 (laya-server) path /v1/systemone
DECISIONS_PROVIDER=jev
DECISIONS_BASE_URL=https://api.typesafe.ai
DECISIONS_PATH=/v1/systemone
DECISIONS_API_KEY=
DECISIONS_MODEL_ID=
# Vela 'span' questions (0G only)
ENABLE_SPANS=false
# Tokens the model reads; Laya EN = 512, Vela = 16384
TOKEN_BUDGET=512

# ---- network ----
REPORT_BOARD_URL=http://localhost:8787
CHAIN_ID=5042002
SQ_CONTROLLER_ADDRESS=0x000000000000000000000000000000000000dEaD
PORT=8801
