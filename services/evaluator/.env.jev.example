# Optional JEV evaluator. It inherits JEV_API_KEY/JEV_MODEL from .env.
EVALUATOR_ID=jev-1.judges.semanticquorum.eth
EVALUATOR_PROFILE=jev-systemone-v1
# DEV only: may share a test signer/payout address. Use an independent key in production.
EVALUATOR_REPORT_KEY=
DECISIONS_PROVIDER=jev
# JEV does not return 0G's tee_verified attestation field.
REQUIRE_TEE=false
TOKEN_BUDGET=16384
PORT=8803
