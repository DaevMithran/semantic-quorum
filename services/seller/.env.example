# Seller agent: writes the page on 0G Private Computer, revises on feedback, submits on Arc after PASS.
SELLER_LLM_BASE_URL=https://router-api.0g.ai
SELLER_LLM_API_KEY=
SELLER_MODEL=0GM-1.0-35B-A3B
SELLER_MAX_ROUNDS=4
COORDINATOR_URL=http://localhost:8787
# arc = submit the passing version on Arc testnet; off = stop at PASS
SUBMIT=off
ARC_RPC_URL=https://rpc.testnet.arc.io
# Testnet-only wallet that is the job's provider. Never a mainnet key.
SELLER_KEY=
